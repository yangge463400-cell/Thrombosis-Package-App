# ============================================================
# 后端环境变量模板（复制到服务器 /opt/thrombosis/thrombosis.env，chmod 600）
# 切勿提交真实值到 git
# ============================================================

SPRING_PROFILES_ACTIVE=prod

# --- 数据库 ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=thrombosis
DB_USER=thrombosis
DB_PASSWORD=请改成强密码

# --- JWT（必须更换：openssl rand -hex 32）---
JWT_SECRET=请用 openssl rand -hex 32 生成

# --- 微信小程序（mp.weixin.qq.com → 开发管理 → 开发设置）---
WX_APPID=你的小程序AppID
WX_SECRET=你的小程序AppSecret

# --- 微信支付（接入真实支付后填写）---
WX_MCH_ID=
WX_NOTIFY_URL=

# --- CORS（管理端域名）---
CORS_ORIGINS=https://jiangsuhongqing.com

# --- 种子账号初始密码（首次启动生效，务必强密码）---
INIT_ADMIN_PASSWORD=请改成强密码
INIT_HOSPITAL_ADMIN_PASSWORD=请改成强密码
INIT_STAFF_PASSWORD=请改成强密码
