.pd-page { min-height: 100vh; background: #F5F7FA; }
.pd-swiper { height: 420rpx; }
.pd-img { width: 100%; height: 420rpx; background: #E8F3FF; }
.pd-price-card {
  background: #FFFFFF;
  padding: 32rpx;
  border-radius: 0 0 24rpx 24rpx;
}
.pd-price-row { display: flex; align-items: center; }
.pd-status-off {
  margin-left: 20rpx;
  font-size: 32rpx;
  color: #FF4D4F;
  background: #FFF1F0;
  padding: 8rpx 24rpx;
  border-radius: 28rpx;
}
.pd-name {
  font-size: 44rpx;
  font-weight: bold;
  color: #1F3A5F;
  margin-top: 16rpx;
  line-height: 1.3;
}
.pd-sales { font-size: 28rpx; color: #999999; margin-top: 12rpx; }
.pd-section { margin: 24rpx 32rpx 0; }
.pd-item {
  display: flex;
  align-items: flex-start;
  margin-top: 24rpx;
}
.pd-item-icon {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #F0F5EB;
  color: #52C41A;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  margin-top: 6rpx;
  flex-shrink: 0;
}
.pd-item-info { flex: 1; }
.pd-item-name { display: block; font-size: 36rpx; color: #333333; font-weight: 600; }
.pd-item-desc { display: block; font-size: 32rpx; color: #666666; margin-top: 8rpx; }
.pd-tags { display: flex; flex-wrap: wrap; gap: 16rpx; margin-top: 20rpx; }
.pd-link-row { display: flex; align-items: center; justify-content: space-between; }
.pd-link { font-size: 32rpx; color: #1677FF; }
.pd-collapse { display: flex; align-items: center; justify-content: space-between; }
.pd-arrow { font-size: 32rpx; color: #666666; }
.pd-notice {
  display: block;
  font-size: 32rpx;
  color: #666666;
  line-height: 1.7;
  margin-top: 20rpx;
}
.pd-buy { width: 320rpx; }
