<view class="ol-page">
  <nav-bar title="我的订单" showBack></nav-bar>

  <!-- 状态 tab -->
  <scroll-view scroll-x class="ol-tabs" show-scrollbar="{{false}}">
    <view wx:for="{{tabs}}" wx:key="key"
          class="ol-tab {{activeStatus === item.key ? 'ol-tab-active' : ''}}"
          bindtap="switchTab" data-key="{{item.key}}">{{item.text}}</view>
  </scroll-view>

  <view class="ol-list">
    <view class="card ol-card" wx:for="{{list}}" wx:key="id" bindtap="goDetail" data-id="{{item.id}}">
      <view class="ol-card-head">
        <text class="ol-order-no">订单号：{{item.orderNo}}</text>
        <tag text="{{item.statusText}}" type="{{item.statusType}}"></tag>
      </view>
      <view class="ol-card-body">
        <image class="ol-cover" src="{{item.cover}}" mode="aspectFill"></image>
        <view class="ol-info">
          <text class="ol-name">{{item.packageName}}</text>
          <view class="ol-bottom">
            <price-display value="{{item.payAmount}}" size="normal" color="danger"></price-display>
            <text class="ol-time">{{item.createdAt}}</text>
          </view>
        </view>
      </view>
      <view class="ol-card-actions" catchtap="noop">
        <button wx:if="{{item.status === 'pending_pay'}}" class="btn btn-ghost ol-btn" catchtap="goPay" data-id="{{item.id}}">去支付</button>
        <button wx:if="{{item.status === 'pending_pay'}}" class="btn btn-plain ol-btn" catchtap="onCancel" data-id="{{item.id}}">取消订单</button>
        <button wx:if="{{item.status === 'paid'}}" class="btn btn-ghost ol-btn" catchtap="goCode" data-id="{{item.id}}">查看核销码</button>
        <button wx:if="{{item.status === 'paid'}}" class="btn btn-primary ol-btn" catchtap="goHospital" data-id="{{item.id}}">前往检测</button>
        <button wx:if="{{item.status === 'completed'}}" class="btn btn-ghost ol-btn" catchtap="goResult" data-id="{{item.id}}">查看结果</button>
        <button wx:if="{{item.status === 'completed'}}" class="btn btn-plain ol-btn" catchtap="goBuyAgain">再次购买</button>
      </view>
    </view>
  </view>

  <empty-state wx:if="{{!loading && list.length === 0}}" text="暂无相关订单" btnText="去逛逛" bindaction="goPackage"></empty-state>
  <view wx:if="{{loading}}" class="ol-loading">加载中...</view>
  <view style="height: 40rpx;"></view>
</view>
