.ol-page { min-height: 100vh; background: #F5F7FA; }
.ol-tabs {
  display: flex;
  background: #FFFFFF;
  white-space: nowrap;
  padding: 0 16rpx;
}
.ol-tab {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 104rpx;
  padding: 0 32rpx;
  font-size: 32rpx;
  color: #666666;
  position: relative;
}
.ol-tab-active { color: #1677FF; font-weight: 600; }
.ol-tab-active::after {
  content: '';
  position: absolute;
  bottom: 8rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 48rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background: #1677FF;
}
.ol-list { padding: 24rpx 32rpx 0; }
.ol-card { margin-bottom: 24rpx; }
.ol-card-head { display: flex; align-items: center; justify-content: space-between; }
.ol-order-no { font-size: 28rpx; color: #999999; }
.ol-card-body { display: flex; margin-top: 20rpx; }
.ol-cover { width: 140rpx; height: 140rpx; border-radius: 12rpx; background: #E8F3FF; flex-shrink: 0; }
.ol-info { flex: 1; margin-left: 24rpx; display: flex; flex-direction: column; justify-content: space-between; }
.ol-name { font-size: 36rpx; color: #333333; font-weight: 600; line-height: 1.3; }
.ol-bottom { display: flex; align-items: baseline; justify-content: space-between; }
.ol-time { font-size: 28rpx; color: #999999; }
.ol-card-actions { display: flex; justify-content: flex-end; gap: 16rpx; margin-top: 20rpx; }
.ol-btn { min-width: 200rpx; height: 88rpx; padding: 0 32rpx; }
.ol-loading {
  text-align: center;
  font-size: 28rpx;
  color: #999999;
  padding: 24rpx 0;
}
