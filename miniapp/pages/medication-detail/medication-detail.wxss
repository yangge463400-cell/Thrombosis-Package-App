.md-page { min-height: 100vh; background: #F5F7FA; }
.md-info { margin: 24rpx 32rpx 0; }
.md-drug-row { display: flex; align-items: center; justify-content: space-between; }
.md-drug { font-size: 44rpx; font-weight: bold; color: #1F3A5F; }
.md-status {
  font-size: 28rpx;
  color: #52C41A;
  background: #F0F5EB;
  padding: 6rpx 20rpx;
  border-radius: 28rpx;
}
.md-row { display: flex; align-items: center; margin-top: 16rpx; }
.md-label { font-size: 32rpx; color: #999999; width: 140rpx; flex-shrink: 0; }
.md-value { font-size: 32rpx; color: #333333; }

.md-calendar { margin: 24rpx 32rpx 0; }
.md-cal-head { display: flex; margin-top: 20rpx; }
.md-cal-date {
  flex: 1;
  text-align: center;
  font-size: 28rpx;
  color: #999999;
}
.md-cal-row { display: flex; align-items: center; margin-top: 16rpx; }
.md-cal-time { width: 120rpx; font-size: 32rpx; color: #333333; font-weight: 600; }
.md-cal-days { flex: 1; display: flex; }
.md-cal-day {
  flex: 1;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  color: #C0C8D4;
}
.day-taken {
  background: #F0F5EB;
  color: #52C41A;
  border-radius: 12rpx;
  font-weight: bold;
}
.md-actions { display: flex; gap: 24rpx; padding: 0 32rpx; }
.md-btn { flex: 1; }
