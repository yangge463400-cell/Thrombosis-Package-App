.login-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #E8F3FF 0%, #F5F7FA 45%);
  padding: 0 48rpx;
  box-sizing: border-box;
}
.brand {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 140rpx;
}
.brand-logo {
  width: 160rpx;
  height: 160rpx;
  border-radius: 40rpx;
  background: #FFFFFF;
  box-shadow: 0 8rpx 24rpx rgba(22, 119, 255, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}
.brand-logo image { width: 120rpx; height: 120rpx; }
.brand-name {
  margin-top: 32rpx;
  font-size: 44rpx;
  font-weight: bold;
  color: #1F3A5F;
}
.brand-slogan {
  margin-top: 12rpx;
  font-size: 32rpx;
  color: #666666;
}

.role-switch {
  display: flex;
  margin: 80rpx auto 32rpx;
  width: 480rpx;
  height: 96rpx;
  background: #FFFFFF;
  border-radius: 48rpx;
  padding: 8rpx;
  box-sizing: border-box;
}
.role-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  color: #666666;
  border-radius: 44rpx;
  height: 80rpx;
}
.role-active {
  background: #1677FF;
  color: #FFFFFF;
  font-weight: 600;
  box-shadow: 0 8rpx 24rpx rgba(22, 119, 255, 0.3);
}

.form-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 40rpx 32rpx;
  box-shadow: 0 6rpx 20rpx rgba(10, 30, 60, 0.08);
}
.agree-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  margin-bottom: 32rpx;
}
.agree-box {
  width: 44rpx;
  height: 44rpx;
  border-radius: 12rpx;
  border: 2rpx solid #C0C8D4;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 12rpx;
}
.agree-checked {
  background: #1677FF;
  border-color: #1677FF;
}
.agree-mark { color: #FFFFFF; font-size: 28rpx; }
.agree-text { font-size: 28rpx; color: #666666; }
.agree-link { font-size: 28rpx; color: #1677FF; }

.login-btn { width: 100%; }
.login-tip {
  display: block;
  text-align: center;
  margin-top: 24rpx;
  font-size: 28rpx;
  color: #999999;
}
.error-card {
  margin-top: 32rpx;
  background: #FFF1F0;
  border-radius: 24rpx;
  padding: 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.error-text { font-size: 32rpx; color: #FF4D4F; }
.retry-btn { margin-top: 24rpx; width: 320rpx; }
