.home-page { min-height: 100vh; background: #F5F7FA; }
.search-bar {
  display: flex;
  align-items: center;
  margin: 16rpx 32rpx;
  height: 88rpx;
  background: #FFFFFF;
  border-radius: 44rpx;
  padding: 0 32rpx;
  box-sizing: border-box;
}
.search-icon { font-size: 40rpx; color: #999999; margin-right: 12rpx; }
.search-ph { font-size: 32rpx; color: #999999; }

.banner { margin: 0 32rpx; height: 280rpx; border-radius: 16rpx; overflow: hidden; }
.banner-img { width: 100%; height: 280rpx; background: #E8F3FF; }

.grid {
  display: flex;
  flex-wrap: wrap;
  margin: 24rpx 32rpx 0;
  padding: 24rpx 0 8rpx;
}
.grid-item {
  width: 25%;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 24rpx;
}
.grid-icon {
  position: relative;
  width: 88rpx;
  height: 88rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  font-weight: bold;
}
.gi-blue { background: #E8F3FF; color: #1677FF; }
.gi-green { background: #F0F5EB; color: #52C41A; }
.gi-orange { background: #FFF7E6; color: #AD6800; }
.gi-red { background: #FFF1F0; color: #FF4D4F; }
.gi-gray { background: #F2F4F7; color: #666666; }
.grid-badge {
  position: absolute;
  top: -10rpx;
  right: -14rpx;
  min-width: 36rpx;
  height: 36rpx;
  border-radius: 18rpx;
  background: #FF4D4F;
  color: #FFFFFF;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 8rpx;
  box-sizing: border-box;
}
.grid-text { font-size: 28rpx; color: #666666; margin-top: 12rpx; }

.ongoing-card { margin: 24rpx 32rpx 0; }
.ongoing-head { display: flex; align-items: center; justify-content: space-between; }
.ongoing-title { font-size: 40rpx; font-weight: bold; color: #1F3A5F; }
.ongoing-body {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
}
.ongoing-name { font-size: 36rpx; color: #333333; flex: 1; margin-right: 24rpx; }
.ongoing-actions { display: flex; justify-content: flex-end; margin-top: 24rpx; }
.ongoing-btn { width: 240rpx; height: 88rpx; }

.recommend { margin: 0 32rpx; }
.recommend-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 20rpx; }
.recommend-more { font-size: 32rpx; color: #1677FF; }
.recommend-scroll { white-space: nowrap; }
.rec-card {
  display: inline-block;
  width: 300rpx;
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-right: 24rpx;
  box-sizing: border-box;
  box-shadow: 0 6rpx 20rpx rgba(10, 30, 60, 0.08);
}
.rec-img { width: 260rpx; height: 180rpx; border-radius: 12rpx; background: #E8F3FF; }
.rec-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
  margin-top: 16rpx;
  white-space: normal;
  line-height: 1.3;
  min-height: 80rpx;
}
.rec-bottom { display: flex; align-items: baseline; justify-content: space-between; margin-top: 12rpx; }
.rec-sales { font-size: 28rpx; color: #999999; }
