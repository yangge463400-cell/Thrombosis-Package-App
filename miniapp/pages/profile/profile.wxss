.pf-page { min-height: 100vh; background: #F5F7FA; }
.pf-user {
  display: flex;
  align-items: center;
  margin: 0 32rpx;
  background: linear-gradient(135deg, #1677FF 0%, #4D9BFF 100%);
  border-radius: 24rpx;
  padding: 40rpx 32rpx;
}
.pf-avatar-wrap { flex-shrink: 0; }
.pf-avatar {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.2);
  border: 4rpx solid rgba(255, 255, 255, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
}
.pf-avatar-default {
  font-size: 60rpx;
  color: #FFFFFF;
}
.pf-user-info { margin-left: 32rpx; }
.pf-nickname { display: block; font-size: 44rpx; font-weight: bold; color: #FFFFFF; }
.pf-phone { display: block; font-size: 32rpx; color: rgba(255, 255, 255, 0.85); margin-top: 12rpx; }

.pf-profile { margin: 24rpx 32rpx 0; }
.pf-profile-head { display: flex; align-items: center; justify-content: space-between; }
.pf-edit { font-size: 32rpx; color: #1677FF; }
.pf-profile-items {
  display: flex;
  flex-wrap: wrap;
  margin-top: 24rpx;
}
.pf-p-item { width: 50%; display: flex; align-items: center; margin-bottom: 20rpx; }
.pf-p-label { font-size: 32rpx; color: #999999; margin-right: 16rpx; }
.pf-p-value { font-size: 34rpx; color: #333333; font-weight: 600; }

.pf-menu { margin: 24rpx 32rpx 0; padding: 0; overflow: hidden; }
.pf-msg-badge {
  min-width: 36rpx;
  height: 36rpx;
  border-radius: 18rpx;
  background: #FF4D4F;
  color: #FFFFFF;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 8rpx;
  margin-right: 8rpx;
  box-sizing: border-box;
}
.pf-logout { width: calc(100% - 64rpx); margin-left: 32rpx; margin-right: 32rpx; }
