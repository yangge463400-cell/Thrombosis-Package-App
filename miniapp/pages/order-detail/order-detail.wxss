.od-page { min-height: 100vh; background: #F5F7FA; }
.od-status-card {
  background: linear-gradient(135deg, #1677FF 0%, #4D9BFF 100%);
  border-radius: 0 0 32rpx 32rpx;
  padding: 40rpx 32rpx 24rpx;
}
.od-status-title { display: block; font-size: 44rpx; font-weight: bold; color: #FFFFFF; }
.od-status-desc { display: block; font-size: 32rpx; color: rgba(255, 255, 255, 0.85); margin-top: 12rpx; }
.od-steps-wrap { margin-top: 32rpx; }
.od-steps-wrap .step-text { color: rgba(255, 255, 255, 0.85); }
.od-steps-wrap .step.done .step-text { color: #FFFFFF; }
.od-steps-wrap .step.active .step-text { color: #FFFFFF; }
.od-steps-wrap .step-line { background: rgba(255, 255, 255, 0.3); }
.od-steps-wrap .step-line.line-done { background: #FFFFFF; }
.od-steps-wrap .step-dot { background: rgba(255, 255, 255, 0.3); color: #FFFFFF; }
.od-steps-wrap .step.done .step-dot { background: #FFFFFF; color: #1677FF; }
.od-steps-wrap .step.active .step-dot { background: #FFFFFF; color: #1677FF; box-shadow: 0 0 0 8rpx rgba(255, 255, 255, 0.2); }

.od-code-card { margin: 24rpx 32rpx 0; }
.od-code-head { display: flex; align-items: center; justify-content: space-between; }
.od-code-title { font-size: 40rpx; font-weight: bold; color: #1F3A5F; }
.od-code-toggle { font-size: 32rpx; color: #1677FF; }
.od-code-num {
  font-size: 88rpx;
  font-weight: bold;
  color: #1677FF;
  text-align: center;
  letter-spacing: 12rpx;
  margin: 32rpx 0 24rpx;
  font-family: "Courier New", monospace;
}
.od-code-tip {
  display: block;
  text-align: center;
  font-size: 32rpx;
  color: #666666;
}
.od-qr-block { display: flex; flex-direction: column; align-items: center; padding: 16rpx 0; }
.od-qr-img { width: 360rpx; height: 360rpx; margin-bottom: 16rpx; background: #FFFFFF; }

.od-row { display: flex; }
.od-cover { width: 140rpx; height: 140rpx; border-radius: 12rpx; background: #E8F3FF; flex-shrink: 0; }
.od-pkg-info { flex: 1; margin-left: 24rpx; display: flex; flex-direction: column; justify-content: space-between; }
.od-pkg-name { font-size: 36rpx; font-weight: 600; color: #333333; line-height: 1.3; }
.od-divider { height: 1rpx; background: #EEF1F6; margin: 24rpx 0; }
.od-info-row { display: flex; align-items: center; justify-content: space-between; min-height: 88rpx; }
.od-info-label { font-size: 32rpx; color: #999999; }
.od-info-value { font-size: 32rpx; color: #333333; }

.od-actions { display: flex; gap: 24rpx; padding: 0 32rpx; }
.od-btn { flex: 1; }
