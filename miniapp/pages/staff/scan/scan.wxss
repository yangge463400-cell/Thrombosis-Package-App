.scan-page { min-height: 100vh; background: #F5F7FA; }
.scan-frame {
  position: relative;
  margin: 32rpx;
  height: 420rpx;
  background: #0F1E33;
  border-radius: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}
.scan-corner {
  position: absolute;
  width: 72rpx;
  height: 72rpx;
  border: 8rpx solid #1677FF;
}
.scan-corner.tl { top: 40rpx; left: 40rpx; border-right: none; border-bottom: none; }
.scan-corner.tr { top: 40rpx; right: 40rpx; border-left: none; border-bottom: none; }
.scan-corner.bl { bottom: 40rpx; left: 40rpx; border-right: none; border-top: none; }
.scan-corner.br { bottom: 40rpx; right: 40rpx; border-left: none; border-top: none; }
.scan-hint { font-size: 34rpx; color: #FFFFFF; }
.scan-camera-btn { margin-top: 40rpx; width: 280rpx; height: 88rpx; font-size: 32rpx; }

.scan-manual {
  margin: 0 32rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 32rpx;
}
.scan-manual-title {
  display: block;
  text-align: center;
  font-size: 32rpx;
  color: #666666;
  margin-bottom: 24rpx;
}

.scan-confirm { margin: 24rpx 32rpx 0; }
.scan-c-head { display: flex; align-items: center; justify-content: space-between; }
.scan-c-title { font-size: 40rpx; font-weight: bold; color: #1F3A5F; }
.scan-c-status {
  font-size: 28rpx;
  color: #1677FF;
  background: #E8F3FF;
  padding: 6rpx 20rpx;
  border-radius: 28rpx;
}
.scan-c-row { display: flex; align-items: center; margin-top: 16rpx; }
.scan-c-label { font-size: 32rpx; color: #999999; width: 140rpx; flex-shrink: 0; }
.scan-c-value { font-size: 32rpx; color: #333333; flex: 1; }
.scan-confirm-btn { width: 100%; }
