.pe-page { min-height: 100vh; background: #F5F7FA; }
.pe-row {
  display: flex;
  align-items: center;
  min-height: 120rpx;
  border-bottom: 1rpx solid #EEF1F6;
}
.pe-row:last-child { border-bottom: none; }
.pe-label { font-size: 36rpx; color: #333333; width: 160rpx; flex-shrink: 0; }
.pe-radio-group { display: flex; gap: 24rpx; flex: 1; }
.pe-radio {
  min-width: 160rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  color: #666666;
  background: #F5F7FA;
  border-radius: 44rpx;
  box-sizing: border-box;
}
.pe-radio-active {
  background: #E8F3FF;
  color: #1677FF;
  font-weight: 600;
}
.pe-input-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  height: 88rpx;
  background: #F5F7FA;
  border-radius: 24rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
}
.pe-input { flex: 1; font-size: 36rpx; }
.pe-unit { font-size: 32rpx; color: #999999; margin-left: 12rpx; }
.pe-save { width: 100%; }
.pe-tip {
  display: block;
  text-align: center;
  font-size: 28rpx;
  color: #999999;
}
