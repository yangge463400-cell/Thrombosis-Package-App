.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}
.empty-icon { width: 160rpx; height: 160rpx; margin-bottom: 24rpx; opacity: 0.5; }
.empty-icon-default {
  background: #EEF1F6;
  border-radius: 32rpx;
}
.empty-text { font-size: 32rpx; color: #666666; margin-bottom: 32rpx; }
.empty-btn { width: 320rpx; }
