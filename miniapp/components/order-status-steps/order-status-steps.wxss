.steps {
  display: flex;
  align-items: flex-start;
  padding: 32rpx 0;
}
.step {
  position: relative;
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.step-dot {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #EEF1F6;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #999999;
  font-size: 28rpx;
  z-index: 2;
}
.step.done .step-dot { background: #52C41A; color: #FFFFFF; }
.step.active .step-dot { background: #1677FF; color: #FFFFFF; box-shadow: 0 0 0 8rpx #E8F3FF; }
.step-text {
  margin-top: 12rpx;
  font-size: 28rpx;
  color: #999999;
  white-space: nowrap;
}
.step.done .step-text { color: #52C41A; }
.step.active .step-text { color: #1677FF; font-weight: 600; }
.step-line {
  position: absolute;
  top: 24rpx;
  left: 50%;
  width: 100%;
  height: 4rpx;
  background: #EEF1F6;
}
.step-line.line-done { background: #52C41A; }
.step:first-child .step-line { display: block; }
